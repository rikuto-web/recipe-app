[Unit]
Description=Recipe Frontend (TanStack Start)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/recipe-app/frontend
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=384
Environment=SSR_API_BASE=http://127.0.0.1
ExecStart=/usr/bin/node /opt/recipe-app/frontend/server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
