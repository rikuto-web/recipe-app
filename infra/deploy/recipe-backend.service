[Unit]
Description=Recipe Backend API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/recipe-app
Environment=HOST=0.0.0.0
Environment=PORT=8080
Environment=DATABASE_URL=sqlite:/opt/recipe-app/data/recipe.db
ExecStart=/opt/recipe-app/recipe-backend
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
